# скопируйте в .env и задайте свой пароль; сам .env в git не коммитьте
POSTGRES_DB=productmanager
POSTGRES_USER=productmanager
POSTGRES_PASSWORD=change-me
DB_PORT=5433

# администратор (создаётся при старте приложения, если ещё нет)
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=admin123

# обычные пользователи регистрируются через веб-форму (email + пароль ≥ 6);
# сессия хранится в cookie JSESSIONID
